# Copy to `.env` (git-ignored) and fill in. Loaded automatically by mlops_vera/config.py.

# MLflow tracking server hosted by DagsHub. Leave these unset to log locally to ./mlflow.db.
MLFLOW_TRACKING_URI=https://dagshub.com/AdriSegurao/MLOps-Vera.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
# DagsHub access token: https://dagshub.com/user/settings/tokens
MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>

# Silence MLflow's "agent hint" banner printed on import.
MLFLOW_DISABLE_AGENT_HINT=1
